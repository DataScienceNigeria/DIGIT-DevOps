# Core Services Helmfile Configuration - Fixed Version
# This version addresses deployment issues and ensures proper service creation

environments:
  default:
    values:
      - ../environments/env.yaml
      - ../environments/env-secrets.yaml

---

templates:
  default: &default
    chart: ../../charts/common
    version: 0.1.0
    namespace: egov
    missingFileHandler: Warn
    timeout: 600
    wait: true
    waitForJobs: true
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml

releases:
  # ConfigMaps service - this one is working
  - name: configmaps
    installed: true
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: "configmaps"
        namespace: "egov"
        image:
          repository: "nginx"
          tag: "latest"
          pullPolicy: "IfNotPresent"
        replicas: 1
        resources:
          limits:
            cpu: 100m
            memory: 128Mi
          requests:
            cpu: 50m
            memory: 64Mi
        service:
          enabled: true
          type: ClusterIP
          port: 80
        healthChecks:
          enabled: false
        autoscaling:
          enabled: false

  # EGOV MDMS Service - core service
  - name: egov-mdms-service
    installed: true
    <<: *default
    needs:
      - configmaps
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: "egov-mdms-service"
        namespace: "egov"
        image:
          repository: "egovio/egov-mdms-service"
          tag: "v1.3.2-72f8a8f87b-24"
          pullPolicy: "IfNotPresent"
        replicas: 1
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 256Mi
        service:
          enabled: true
          type: ClusterIP
          port: 8080
          targetPort: 8080
        healthChecks:
          enabled: true
          livenessProbe:
            httpGet:
              path: "/egov-mdms-service/health"
              port: 8080
            initialDelaySeconds: 90
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: "/egov-mdms-service/health"
              port: 8080
            initialDelaySeconds: 60
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
        autoscaling:
          enabled: false
        env:
          - name: "SERVER_PORT"
            value: "8080"
          - name: "JAVA_OPTS"
            value: "-Xmx256m -Xms256m"
          - name: "SPRING_DATASOURCE_URL"
            value: "jdbc:postgresql://postgresql.backbone:5432/devdb"
          - name: "SPRING_DATASOURCE_USERNAME"
            value: "postgres"
          - name: "SPRING_DATASOURCE_PASSWORD"
            value: "postgres"
          - name: "EGOV_MDMS_CONF_PATH"
            value: "https://raw.githubusercontent.com/egovernments/egov-mdms-data/master/data"

  # EGOV FileStore Service
  - name: egov-filestore
    installed: true
    <<: *default
    needs:
      - configmaps
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: "egov-filestore"
        namespace: "egov"
        image:
          repository: "egovio/egov-filestore"
          tag: "v1.2.4-72f8a8f87b-24"
          pullPolicy: "IfNotPresent"
        replicas: 1
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 256Mi
        service:
          enabled: true
          type: ClusterIP
          port: 8080
          targetPort: 8080
        healthChecks:
          enabled: true
          livenessProbe:
            httpGet:
              path: "/filestore/health"
              port: 8080
            initialDelaySeconds: 90
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: "/filestore/health"
              port: 8080
            initialDelaySeconds: 60
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
        autoscaling:
          enabled: false
        env:
          - name: "SERVER_PORT"
            value: "8080"
          - name: "JAVA_OPTS"
            value: "-Xmx256m -Xms256m"
          - name: "SPRING_DATASOURCE_URL"
            value: "jdbc:postgresql://postgresql.backbone:5432/devdb"
          - name: "SPRING_DATASOURCE_USERNAME"
            value: "postgres"
          - name: "SPRING_DATASOURCE_PASSWORD"
            value: "postgres"
          - name: "MINIO_URL"
            value: "http://minio.backbone:9000"
          - name: "MINIO_ACCESS_KEY"
            value: "minio"
          - name: "MINIO_SECRET_KEY"
            value: "minio123"

  # EGOV Localization Service
  - name: egov-localization
    installed: true
    <<: *default
    needs:
      - configmaps
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: "egov-localization"
        namespace: "egov"
        image:
          repository: "egovio/egov-localization"
          tag: "v1.1.3-72f8a8f87b-24"
          pullPolicy: "IfNotPresent"
        replicas: 1
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 256Mi
        service:
          enabled: true
          type: ClusterIP
          port: 8080
          targetPort: 8080
        healthChecks:
          enabled: true
          livenessProbe:
            httpGet:
              path: "/localization/health"
              port: 8080
            initialDelaySeconds: 90
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: "/localization/health"
              port: 8080
            initialDelaySeconds: 60
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
        autoscaling:
          enabled: false
        env:
          - name: "SERVER_PORT"
            value: "8080"
          - name: "JAVA_OPTS"
            value: "-Xmx256m -Xms256m"
          - name: "SPRING_DATASOURCE_URL"
            value: "jdbc:postgresql://postgresql.backbone:5432/devdb"
          - name: "SPRING_DATASOURCE_USERNAME"
            value: "postgres"
          - name: "SPRING_DATASOURCE_PASSWORD"
            value: "postgres"

  # EGOV ID Generation Service
  - name: egov-idgen
    installed: true
    <<: *default
    needs:
      - configmaps
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: "egov-idgen"
        namespace: "egov"
        image:
          repository: "egovio/egov-idgen"
          tag: "v1.2.3-72f8a8f87b-24"
          pullPolicy: "IfNotPresent"
        replicas: 1
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 256Mi
        service:
          enabled: true
          type: ClusterIP
          port: 8080
          targetPort: 8080
        healthChecks:
          enabled: true
          livenessProbe:
            httpGet:
              path: "/egov-idgen/health"
              port: 8080
            initialDelaySeconds: 90
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: "/egov-idgen/health"
              port: 8080
            initialDelaySeconds: 60
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
        autoscaling:
          enabled: false
        env:
          - name: "SERVER_PORT"
            value: "8080"
          - name: "JAVA_OPTS"
            value: "-Xmx256m -Xms256m"
          - name: "SPRING_DATASOURCE_URL"
            value: "jdbc:postgresql://postgresql.backbone:5432/devdb"
          - name: "SPRING_DATASOURCE_USERNAME"
            value: "postgres"
          - name: "SPRING_DATASOURCE_PASSWORD"
            value: "postgres"

  # EGOV User Service
  - name: egov-user
    installed: true
    <<: *default
    needs:
      - egov-mdms-service
      - configmaps
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: "egov-user"
        namespace: "egov"
        image:
          repository: "egovio/egov-user"
          tag: "v1.2.7-96b24b0d72-24"
          pullPolicy: "IfNotPresent"
        replicas: 1
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 256Mi
        service:
          enabled: true
          type: ClusterIP
          port: 8080
          targetPort: 8080
        healthChecks:
          enabled: true
          livenessProbe:
            httpGet:
              path: "/user/health"
              port: 8080
            initialDelaySeconds: 90
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: "/user/health"
              port: 8080
            initialDelaySeconds: 60
            timeoutSeconds: 3
            periodSeconds: 30
            successThreshold: 1
            failureThreshold: 5
        autoscaling:
          enabled: false
        env:
          - name: "SERVER_PORT"
            value: "8080"
          - name: "JAVA_OPTS"
            value: "-Xmx256m -Xms256m"
          - name: "SPRING_DATASOURCE_URL"
            value: "jdbc:postgresql://postgresql.backbone:5432/devdb"
          - name: "SPRING_DATASOURCE_USERNAME"
            value: "postgres"
          - name: "SPRING_DATASOURCE_PASSWORD"
            value: "postgres"
          - name: "EGOV_MDMS_HOST"
            value: "http://egov-mdms-service.egov:8080"
          - name: "EGOV_FILESTORE_HOST"
            value: "http://egov-filestore.egov:8080"
          - name: "EGOV_LOCALIZATION_HOST"
            value: "http://egov-localization.egov:8080"