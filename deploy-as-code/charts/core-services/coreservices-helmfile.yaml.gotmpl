# Fixed Core Services Helmfile
templates:
  default: &default
    chart: ../../charts/common
    version: 0.1.0
    namespace: egov
    installed: true
    missingFileHandler: Warn
    timeout: 600
    wait: true

releases:
  # Core infrastructure services (deploy first)
  - name: configmaps
    installed: true
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: configmaps

  # Core data services
  - name: egov-mdms-service
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-mdms-service

  # Authentication and authorization services
  - name: egov-accesscontrol
    installed: true
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-accesscontrol

  - name: egov-enc-service
    installed: true
    needs:
      - egov-mdms-service
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-enc-service

  - name: egov-filestore
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-filestore

  - name: egov-idgen
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-idgen

  - name: egov-localization
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-localization

  - name: egov-location
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-location

  # User management services
  - name: egov-user
    installed: true
    needs:
      - egov-enc-service
      - egov-mdms-service
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-user

  - name: egov-otp
    installed: true
    needs:
      - egov-user
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-otp

  - name: user-otp
    installed: true
    needs:
      - egov-otp
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: user-otp

  # HR management
  - name: egov-hrms
    installed: true
    needs:
      - egov-user
      - egov-mdms-service
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-hrms

  # Workflow services
  - name: egov-workflow-v2
    installed: true
    needs:
      - egov-mdms-service
      - egov-user
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-workflow-v2

  # Notification services
  - name: egov-notification-mail
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-notification-mail

  - name: egov-notification-sms
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-notification-sms

  # Data processing services
  - name: egov-indexer
    installed: true
    needs:
      - egov-mdms-service
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-indexer

  - name: egov-persister
    installed: true
    needs:
      - egov-mdms-service
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-persister

  - name: audit-service
    installed: true
    needs:
      - egov-mdms-service
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: audit-service

  # Utility services
  - name: egov-url-shortening
    installed: true
    needs:
      - configmaps
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-url-shortening

  - name: egov-user-event
    installed: true
    needs:
      - egov-user
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-user-event

  # Payment services
  - name: egov-pg-service
    installed: true
    needs:
      - egov-mdms-service
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: egov-pg-service

  # Application services
  - name: pgr-services
    installed: true
    needs:
      - egov-workflow-v2
      - egov-user
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: pgr-services

  - name: service-request
    installed: true
    needs:
      - egov-workflow-v2
      - egov-user
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: service-request

  # UI services
  - name: citizen
    installed: true
    needs:
      - egov-user
      - egov-localization
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: citizen

  - name: employee
    installed: true
    needs:
      - egov-user
      - egov-localization
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: employee

  - name: digit-ui
    installed: true
    needs:
      - citizen
      - employee
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: digit-ui

  # Gateway (deploy last)
  - name: gateway
    installed: true
    needs:
      - egov-user
      - egov-accesscontrol
    <<: *default
    values:
      - ../environments/env-secrets.yaml
      - ../environments/env.yaml
      - name: gateway